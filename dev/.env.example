# Copy to dev/.env (git-ignored) and adjust the checkout paths to your machine.
# Recipes in the root justfile load this file; see dev/README.md.

# Checkout paths of the owning repositories.
KIROKU_REPO=/Users/shinzui/Keikaku/bokuno/kiroku-project/kiroku
PGMQ_HS_REPO=/Users/shinzui/Keikaku/bokuno/libraries/pgmq-hs-project/pgmq-hs
SHIBUYA_REPO=/Users/shinzui/Keikaku/bokuno/shibuya-project/shibuya
SHIBUYA_PGMQ_ADAPTER_REPO=/Users/shinzui/Keikaku/bokuno/shibuya-project/shibuya-pgmq-adapter
KEIRO_REPO=/Users/shinzui/Keikaku/bokuno/keiro

# keiro's dev PostgreSQL is socket-only; its socket directory is <KEIRO_REPO>/db and the
# jitsurei seed lives in the database "jitsurei" (kiroku schema "kiroku").
STACK_PG_SOCKET_DIR=/Users/shinzui/Keikaku/bokuno/keiro/db
STACK_PG_DATABASE=jitsurei
STACK_DATABASE_URL="host=/Users/shinzui/Keikaku/bokuno/keiro/db dbname=jitsurei"

# The jitsurei database carries no pgmq schema, so pgmq-inspect and the shibuya example
# consumer share pgmq-hs's own socket-only dev cluster (<PGMQ_HS_REPO>/.dev/db), database
# "pgmq_dev", with pgmq-migration's native schema installed by `just stack-seed`.
STACK_PGMQ_SOCKET_DIR=/Users/shinzui/Keikaku/bokuno/libraries/pgmq-hs-project/pgmq-hs/.dev/db
STACK_PGMQ_DATABASE=pgmq_dev
STACK_PGMQ_DATABASE_URL="host=/Users/shinzui/Keikaku/bokuno/libraries/pgmq-hs-project/pgmq-hs/.dev/db dbname=pgmq_dev"
# The shibuya baseline consumes its demo queues here in every profile.
STACK_SHIBUYA_DATABASE_URL="host=/Users/shinzui/Keikaku/bokuno/libraries/pgmq-hs-project/pgmq-hs/.dev/db dbname=pgmq_dev"
STACK_PROFILE=jitsurei

# The console's dev origin; every surface allow-lists it.
STACK_CONSOLE_ORIGIN=http://localhost:5173

# Fixed local ports (docs/masterplans/2-build-the-keiro-runtime-console.md).
STACK_SHIBUYA_PORT=9090
STACK_KIROKU_PORT=9091
STACK_PGMQ_PORT=9095
STACK_KEIRO_PORT=9093
STACK_KEIRO_MUTATIONS_PORT=9094
