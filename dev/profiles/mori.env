# The mori profile (dev/README.md): kiroku-inspect, pgmq-inspect, and keiro-ops-http read the
# local mori dev database instead of jitsurei/pgmq_dev. Loaded after dev/.env by
# `just stack-up mori`. Adjust MORI_REPO to your checkout.
STACK_PROFILE=mori
MORI_REPO=/Users/shinzui/Keikaku/bokuno/mori-project/mori
STACK_DATABASE_URL="host=/Users/shinzui/Keikaku/bokuno/mori-project/mori/db dbname=mori"
STACK_PGMQ_DATABASE_URL="host=/Users/shinzui/Keikaku/bokuno/mori-project/mori/db dbname=mori"
# `mori automate daemon` serves its live subscription registry here (no WebSocket, no CORS).
STACK_MORI_METRICS_PORT=9191
