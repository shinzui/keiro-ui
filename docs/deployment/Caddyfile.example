# Recipe A (docs/deployment.md): the console bundle at /console/ and four inspection servers
# behind one origin. Replace /srv/console with the unpacked bundle and the ports with yours.
:8080 {
	redir /console /console/ 301

	handle_path /console/* {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}

	handle_path /kiroku/* {
		reverse_proxy 127.0.0.1:9091
	}
	handle_path /shibuya/* {
		reverse_proxy 127.0.0.1:9090
	}
	handle_path /pgmq/* {
		reverse_proxy 127.0.0.1:9095
	}
	handle_path /keiro/* {
		reverse_proxy 127.0.0.1:9093
	}
}
