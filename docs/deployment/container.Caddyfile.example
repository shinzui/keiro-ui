# Mount at /etc/caddy/Caddyfile. This example matches the root image.
# Replace application.internal:9000 with your composed inspection service.
{
	admin off
	auto_https off
	persist_config off
}
:8080 {
	log {
		output stdout
	}
	@inspection path /kiroku /kiroku/* /shibuya /shibuya/* /pgmq /pgmq/* /keiro /keiro/*
	handle @inspection {
		# Keep prefixes for an application that composes the four surfaces.
		# Caddy preserves Host and handles WebSocket upgrades automatically.
		reverse_proxy application.internal:9000
	}
	handle {
		root * /srv/console
		handle /console-config.json {
			header Cache-Control "no-store"
			file_server
		}
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
