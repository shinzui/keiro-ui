# Recipe A (docs/user/deployment.md) for nginx. Inside an http { } block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;

    location = /console { return 301 /console/; }

    location /console/ {
        alias /srv/console/;
        try_files $uri $uri/ /console/index.html;
    }

    # One block per surface. The trailing slash on proxy_pass strips the prefix. Keep the
    # browser's Host: keiro-ops-http admits a WebSocket whose Origin equals scheme://Host, and
    # nginx's default ($proxy_host) would make every /keiro/ws upgrade a 403 origin_not_allowed.
    location /kiroku/ {
        proxy_pass http://127.0.0.1:9091/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location /shibuya/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location /pgmq/ {
        proxy_pass http://127.0.0.1:9095/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location /keiro/ {
        proxy_pass http://127.0.0.1:9093/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
