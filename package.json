{
  "name": "keiro-ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @keiro-ui/console dev",
    "build": "bun run --filter @keiro-ui/console build",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "vitest run",
    "test:e2e": "bun run --filter @keiro-ui/console test:e2e",
    "fixtures:record": "bun run --filter @keiro-ui/testing record"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "packageManager": "bun@1.4.2"
}
